<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- 1. TELA INICIAL (HOME) -->
    <LinearLayout
        android:id="@+id/layoutHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AutoVideoEditor"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCreateProject"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:text="+ Criar Novo Projeto"
            android:backgroundTint="#6200EE"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Projetos Recentes / Rascunhos"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvEmptyProjects"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ainda não existe nenhum projeto"
            android:textColor="#888888"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutProjectItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#1E1E1E"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Rascunho #1 - Mídias e Narração"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnDeleteProject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Excluir"
                android:backgroundTint="#B00020" />
        </LinearLayout>
    </LinearLayout>

    <!-- 2. TELA DO EDITOR -->
    <LinearLayout
        android:id="@+id/layoutEditor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Barra Superior -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#1E1E1E"
            android:padding="8dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Voltar" />

            <Button
                android:id="@+id/btnStartAutoEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Iniciar Edição ⚡"
                android:backgroundTint="#03DAC5" />
        </RelativeLayout>

        <!-- Player de Preview -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="#000000">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Pré-visualização do Vídeo"
                android:textColor="#666666" />
        </FrameLayout>

        <!-- Timeline -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="#222222">

            <HorizontalScrollView
                android:id="@+id/timelineScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <View android:layout_width="60dp" android:layout_height="60dp" android:background="#FF5722" android:layout_marginEnd="8dp"/>
                    <View android:layout_width="60dp" android:layout_height="60dp" android:background="#4CAF50" android:layout_marginEnd="8dp"/>
                    <View android:layout_width="60dp" android:layout_height="60dp" android:background="#2196F3" android:layout_marginEnd="8dp"/>
                </LinearLayout>
            </HorizontalScrollView>

            <ImageButton
                android:id="@+id/btnRedArrowAlert"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="#FF0000"
                android:src="@android:drawable/arrow_has_explanation" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Animações de Câmera Selecionadas"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnToggleTransitionMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Seleção de Transições Suaves" />

                <Button
                    android:id="@+id/btnDownloadVideo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Baixar Vídeo Final"
                    android:backgroundTint="#FF9800" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- 3. MODAL DE PROGRESSO DA EDIÇÃO -->
    <FrameLayout
        android:id="@+id/modalProgress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="20dp">

            <ProgressBar
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="12dp"
                android:textColor="#00FF00"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCancelEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:backgroundTint="#B00020" />
        </LinearLayout>
    </FrameLayout>

    <!-- 4. POP-UP DE OPÇÕES DE RESOULUÇÃO DE EXPORTAÇÃO -->
    <FrameLayout
        android:id="@+id/modalExportOptions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecione a Resolução de Exportação"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgResolution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <RadioButton
                    android:id="@+id/rb320p"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="320p (Ultra Leve)"
                    android:textColor="#FFFFFF" />
                <RadioButton
                    android:id="@+id/rb480p"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="480p (Padrão)"
                    android:textColor="#FFFFFF" />
                <RadioButton
                    android:id="@+id/rb720p"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="720p (HD)"
                    android:textColor="#FFFFFF" />
                <RadioButton
                    android:id="@+id/rb1080p"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1080p (Full HD)"
                    android:textColor="#FFFFFF"
                    android:checked="true" />
            </RadioGroup>

            <Button
                android:id="@+id/btnStartExport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Iniciar Salvamento"
                android:backgroundTint="#4CAF50" />
        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
